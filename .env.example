# Internship Hunter - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=Internship Hunter
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key

# Database
DATABASE_URL=sqlite:///./internship_hunter.db

# AI / LLM Configuration
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini

# Browser Automation
HEADLESS_BROWSER=true
BROWSER_TIMEOUT=30000

# Notification (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=

# Job Source API Keys (optional)
REMOTIVE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Scheduling
DISCOVERY_SCHEDULE_HOUR=8
DISCOVERY_SCHEDULE_MINUTE=0
DISCOVERY_FREQUENCY=daily

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=30
REQUEST_DELAY_SECONDS=2
